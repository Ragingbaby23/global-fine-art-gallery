# Shopify Headless Storefront API Configuration
# Leave blank to run in Demo / Curated Catalog Mode with built-in 1-of-1 Checkout Simulation.
# Fill these with your Shopify Store credentials to connect to live Shopify Storefront GraphQL API.

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-gallery-store.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="your-shopify-storefront-public-access-token"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
